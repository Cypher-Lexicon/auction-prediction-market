# ─── Network ─────────────────────────────────────────────────
ARC_TESTNET_RPC_URL="https://testnet.arcscan.app/rpc"

# ─── Deployer Wallet ──────────────────────────────────────
# INPUT. Private key of the wallet that pays gas for deployment.
DEPLOYER_PRIVATE_KEY="0x_your_private_key_here"

# ═══════════════════════════════════════════════════════════
# INPUTS below — required BEFORE running forge script.
# Each variable is labeled with which contract(s) consume it.
# ═══════════════════════════════════════════════════════════

# ─── AuctionManager + MarketFactory ───────────────────────
# INPUT. Public key of the oracle witness wallet. The matching
# private key signs resolution attestations off-chain via ECDSA.
# The oracle is a witness — it never sends on-chain transactions.
# This public address is the reference used to verify attestations.
ORACLE_WITNESS_ADDRESS="0x_oracle_wallet_address"

# ─── AuctionManager ───────────────────────────────────────
# INPUT. Public key of the signer wallet. The matching private
# key is held OFF-CHAIN by the backend server and used to
# SIGN on-chain write transactions (createAuction, setShortlist).
# The contract checks msg.sender == this address to verify
# the write came from the authorized signer.
SIGNER_ADDRESS="0x_signer_wallet_address"

# ─── MarketFactory ────────────────────────────────────────
# INPUT. Wallet that receives the platform's cut from
# publisher fees when claimPublisherFees() is called.
PLATFORM_FEE_RECIPIENT="0x_treasury_or_platform_wallet"

# INPUT. Platform fee in basis points (1000 = 10% of
# publisher fees go to PLATFORM_FEE_RECIPIENT).
MARKET_FACTORY_PLATFORM_FEE_BPS="1000"

# ─── Verification ─────────────────────────────────────────
ETHERSCAN_API_KEY="your_arcscan_api_key"

# ═══════════════════════════════════════════════════════════
# OUTPUTS — generated BY running forge script --broadcast.
# These addresses are printed to console after deployment.
# Save them for future interaction with the contracts.
# ═══════════════════════════════════════════════════════════
# PUBLISHING_RIGHTS_NFT_ADDRESS  = 0x...  (output)
# AUCTION_MANAGER_ADDRESS        = 0x...  (output)
# MARKET_FACTORY_ADDRESS         = 0x...  (output)
